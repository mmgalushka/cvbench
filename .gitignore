# Exclude all.
*

# Except GitHub workflow

!.github/
!.github/**/
!.github/**/*.yaml

# Except source package
!src/
!src/**/
!src/**/*.py
!src/**/*.html
!src/**/*.css
!src/**/*.js
!src/**/*.svg
!src/**/*.ico
!src/**/*.png

# Except tests
!tests/
!tests/**/
!tests/**/*.py

# Except notebooks
!notebooks/
!notebooks/**/
!notebooks/**/*.ipynb

# Except scripts
!scripts/
!scripts/**/
!scripts/**/*

# Except docs site (mkdocs build output in site/ stays ignored)
!docs/
!docs/**/
!docs/**/*.md
!docs/**/*.css
!docs/**/*.html
!docs/**/*.svg

# Except project root files
!helper.sh
!Dockerfile
!docker-compose.yml
!pyproject.toml
!mkdocs.yml
!LICENSE
!README.md
!CONTRIBUTING.md
!.dockerignore
