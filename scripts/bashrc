# CVBench container — interactive shell configuration
# Sourced by bash for interactive sessions only.

[[ $- != *i* ]] && return

# ── Prompt ────────────────────────────────────────────────────────────────
PS1='cvbench:\w\$ '

# ── Banner ────────────────────────────────────────────────────────────────
echo -e "  ______     ______                  _     "
echo -e " / ___\\ \\   / / __ )  ___ _ __   ___| |__  "
echo -e "| |    \\ \\ / /|  _ \\ / _ \\ '_ \\ / __| '_ \\ "
echo -e "| |___  \\ V / | |_) |  __/ | | | (__| | | |"
echo -e " \\____|  \\_/  |____/ \\___|_| |_|\\___|_| |_|"
echo    "Computer Vision Training Sandbox"
echo
echo    "  Type 'commands' to see everything you can do here."
echo

# The `commands` overview is generated from the CLI itself — see
# cvbench.cli.overview. It is installed as a console script by `pip install`.

# ── tm — tmux session manager ─────────────────────────────────────────────
tm() {
    local usage
    usage=$(cat <<'EOF'
Usage:
  tm new <name>       new tmux session
  tm connect <name>   connect / attach to session
  tm delete <name>    delete session
  tm list             list sessions
EOF
)
    if [[ $# -eq 0 ]]; then
        echo "$usage"
        return 0
    fi

    local verb="$1"
    local name="$2"

    case "$verb" in
        new)
            [[ -z "$name" ]] && { echo "tm new requires a session name"; return 1; }
            tmux new-session -s "$name"
            ;;
        connect)
            [[ -z "$name" ]] && { echo "tm connect requires a session name"; return 1; }
            tmux attach-session -t "$name"
            ;;
        delete)
            [[ -z "$name" ]] && { echo "tm delete requires a session name"; return 1; }
            tmux kill-session -t "$name"
            ;;
        list)
            tmux list-sessions 2>/dev/null || echo "No active tmux sessions."
            ;;
        *)
            echo "$usage"
            return 1
            ;;
    esac
}
